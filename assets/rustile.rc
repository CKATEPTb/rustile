#include <windows.h>
#pragma code_page(65001)

101 ICON "assets/rustile.ico"

132 DIALOGEX 0, 0, 244, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Переназначить сочетание?"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", 1010, 12, 9, 220, 47, SS_NOPREFIX
    CONTROL "Отмена", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 72, 61, 60, 18
    CONTROL "Переназначить", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 138, 61, 94, 18
END
