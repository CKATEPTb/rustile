#include <windows.h>
#pragma code_page(65001)

1 RT_MANIFEST "assets/rustile.manifest"
101 ICON "assets/rustile.ico"
RUSTILE_LICENSE RCDATA "LICENSE"

132 DIALOGEX 0, 0, 248, 106
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION ""
FONT 10, "Segoe UI"
BEGIN
    CONTROL "", 1011, "STATIC", SS_OWNERDRAW | SS_NOPREFIX, 14, 9, 220, 20
    LTEXT "", 1010, 14, 32, 220, 34, SS_NOPREFIX
    CONTROL "", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 74, 76, 60, 20
    CONTROL "", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 140, 76, 94, 20
END
